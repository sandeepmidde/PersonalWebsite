# Personal/sensitive files that should never be pushed to GitHub
Resume/Car.pdf
Resume/TargetResume.pdf

# Design-feedback screenshots, not a site asset
ref/

# OS junk files
.DS_Store
Thumbs.db
desktop.ini

# Generated by scripts/build-posts.mjs from /blog — never hand-edited, regenerated
# on every Cloudflare Pages deploy. Source of truth is /blog, not this.
/posts/*.json
/posts/images/

# Node dependencies (Cloudflare installs these fresh at build time)
node_modules/
